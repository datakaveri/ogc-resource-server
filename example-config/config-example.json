{
  "version": "1.0",
  "zookeepers": [
    "zookeeper"
  ],
  "clusterId": "ogc-rs-cluster",
  "commonConfig": {
    "ogcBasePath": "/",
    "catalogId": "stac",
    "dxCatalogueBasePath": "/controlplane/iudx/v2/cat",
    "hostName": "https://dx.example.org/ogc",
    "catServerHost": "dx.example.org",
    "catServerPort": 443,
    "catRequestItemsUri": "/controlplane/iudx/v2/cat/item",
    "databaseHost": "",
    "databasePort": 5432,
    "databaseUser": "",
    "databasePassword": "",
    "databaseName": "ogc_rs_v2",
    "jwtIgnoreExpiry": false,
    "issuer": "dx.example.org/controlplane",
    "auditingExchange": "auditing",
    "auditingRoutingKey": "##",
    "poolSize": 5
  },
  "s3BucketsConfig": {
    "default": {
      "bucket": "",
      "endpoint": "https://s3.ap-south-1.amazonaws.com",
      "region": "ap-south-1",
      "accessKey": "",
      "secretKey": "",
      "pathBasedAccess": false,
      "readAccess": "PRIVATE"
    }
  },
  "host": "ogc.example.org",
  "modules": [
    {
      "id": "ogc.rs.database.DatabaseVerticle",
      "verticleInstances": 1,
      "poolSize": 5
    },
    {
      "id": "ogc.rs.catalogue.CatalogueVerticle",
      "verticleInstances": 1,
      "dxCatalogueBasePath": "/controlplane/iudx/v2/cat",
      "catRequestItemsUri": "/controlplane/iudx/v2/cat/item"
    },
    {
      "id": "ogc.rs.apiserver.ApiServerVerticle",
      "isWorkerVerticle": false,
      "ssl": true,
      "keystore": "secrets/keystore.jks",
      "keystorePassword": "",
      "httpPort": 8080,
      "verticleInstances": 2,
      "geomSpecificMaxLimits": {
        "MULTILINESTRING": 100,
        "MULTIPOINT": 10000,
        "LINESTRING": 100,
        "POINT": 10000,
        "MULTIPOLYGON": 10000,
        "GEOMETRY": 120,
        "POLYGON": 10
      },
      "audience": "dx.example.org/ogc",
      "poolSize": 5,
      "issuers": {
        "jwtIgnoreExpiry": false,
        "jwtLeeway": 60,
        "dx.example.org/controlplane": {
          "type": "remote",
          "audience": [],
          "jwksUrl": "https://dx.example.org/controlplane/iudx/v2/auth/jwks"
        },
        "https://dx.example.org/auth/realms/<realm>": {
          "type": "remote",
          "jwksUrl": "https://dx.example.org/auth/realms/<realm>/protocol/openid-connect/certs",
          "audience": []
        }
      },
      "controlPanelPort": 443,
      "controlPanelHost": "dx.example.org",
      "controlPanelSearchPath": "/controlplane/iudx/acl/apd/v2/access_request/has_access"
    },
    {
      "id": "ogc.rs.databroker.DataBrokerVerticle",
      "verticleInstances": 1,
      "dataBrokerIP": "",
      "dataBrokerPort": 24568,
      "dataBrokerUserName": "",
      "dataBrokerPassword": "",
      "dataBrokerManagementPort": 443,
      "connectionTimeout": 6000,
      "requestedHeartbeat": 60,
      "handshakeTimeout": 6000,
      "requestedChannelMax": 5000,
      "networkRecoveryInterval": 500,
      "prodVhost": "IUDX-V2",
      "internalVhost": "IUDX-V2-INTERNAL"
    },
    {
      "id": "ogc.rs.metering.MeteringVerticle",
      "verticleInstances": 1,
      "meteringDatabaseHost": "",
      "meteringDatabasePort": 5432,
      "meteringDatabaseUser": "",
      "meteringDatabasePassword": "",
      "meteringDatabaseName": "iudx_v2_rs",
      "poolSize": 5
    },
    {
      "id": "ogc.rs.jobs.JobsVerticle",
      "verticleInstances": 1
    },
    {
      "id": "ogc.rs.processes.ProcessVerticle",
      "poolSize": 5,
      "verticleInstances": 1
    }
  ]
}
